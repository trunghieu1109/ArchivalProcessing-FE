# Host port exposed by the frontend container.
FE_HTTP_PORT=5173

# Runtime backend target used by Nginx inside the frontend container.
# Use this default when the backend is exposed on the host at http://127.0.0.1:8000.
ARCHIVAL_API_PROXY_PASS=http://host.docker.internal:8000

# Max request body size accepted by the frontend Nginx proxy.
NGINX_CLIENT_MAX_BODY_SIZE=1g

# Vite build-time API base used by the browser bundle.
# Keep /api when serving through the Docker Nginx reverse proxy.
VITE_ARCHIVAL_API_BASE_URL=/api

# Set true only if the browser should upload directly to presigned storage URLs.
VITE_ARCHIVAL_DIRECT_PRESIGNED_UPLOAD=false

# Enable the browser-direct PDF folder upload manager and global progress dock.
VITE_FOLDER_UPLOAD_ENABLED=true

# Optional frontend override for chunked raw ZIP upload size, in MB.
# Leave blank to use backend CHINHLY_CHUNKED_UPLOAD_CHUNK_SIZE_MB.
VITE_ARCHIVAL_CHUNKED_UPLOAD_CHUNK_SIZE_MB=64

# Bulk metadata actions are submitted in batches to avoid flooding the backend.
VITE_ARCHIVAL_BULK_ACTION_BATCH_SIZE=32
VITE_ARCHIVAL_BULK_ACTION_CONCURRENCY=4

# Local Vite dev-server proxy target for npm run dev.
VITE_ARCHIVAL_DEV_API_PROXY_TARGET=http://127.0.0.1:8000
